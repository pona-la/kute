[Unit]
Description=Stream audio
Wants=network-online.target icecast2.service
After=network.target network-online.target icecast2.service

[Service]
Type=simple
WorkingDirectory=/srv/tpr/ezstream/
ExecStart=ezstream -c config.xml
User=streamer
Group=streamer
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
